---
import '../styles/navigation.css';
const links = [{ href: '/', label: 'Fish Finder' }, { href: '/rods', label: 'Rod Finder' }, { href: '/companions', label: 'Companions' }, { href: '/quests', label: 'Quest Helper' }];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-nav" transition:persist="site-nav">
  <nav class="finder-nav" aria-label="Main navigation">
    <a href="/" class="finder-brand font-display tracking-tight">Fisch Finder</a>
    <ul class="finder-links" id="finder-links">
      {links.map(link => <li><a href={link.href} data-finder-link aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>)}
    </ul>
    <div class="finder-actions">
      <button type="button" class="theme-toggle" data-theme-toggle role="switch" aria-checked="false" aria-label="Dark mode" title="Switch to dark mode">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.9 13.2A9 9 0 0 1 10.8 3.1 9 9 0 1 0 20.9 13.2Z" /></svg>
        <span class="finder-theme-label">Dark mode</span><span class="theme-toggle-track" aria-hidden="true"></span>
      </button>
      <button type="button" class="finder-menu-toggle" data-finder-menu-toggle aria-expanded="false" aria-controls="finder-links" aria-label="Open navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </nav>
</header>
<script>
  function setMenu(open: boolean) {
    const header = document.querySelector<HTMLElement>('.site-nav');
    const button = header?.querySelector<HTMLButtonElement>('[data-finder-menu-toggle]');
    header?.toggleAttribute('data-menu-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
  }
  function syncNavigation() {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-finder-link]').forEach(link => {
      if (link.getAttribute('href') === path) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    setMenu(false);
  }
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('[data-finder-menu-toggle]')) {
      setMenu(!document.querySelector('.site-nav')?.hasAttribute('data-menu-open'));
    } else if (event.target.closest('[data-finder-link]') || !event.target.closest('.site-nav')) setMenu(false);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && document.querySelector('.site-nav')?.hasAttribute('data-menu-open')) {
      setMenu(false); document.querySelector<HTMLButtonElement>('[data-finder-menu-toggle]')?.focus();
    }
  });
  window.matchMedia('(min-width: 960px)').addEventListener('change', () => setMenu(false));
  document.addEventListener('astro:page-load', syncNavigation);
  syncNavigation();
</script>
